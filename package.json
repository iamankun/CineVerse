{
  "name": "cineverse",
  "version": "2.1.0",
  "language-region": "vi-VN",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/cap-nhap-phien-ban.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "generate-icons": "node scripts/tao-bieu-tuong.mjs",
